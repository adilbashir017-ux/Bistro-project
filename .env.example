# Database
BISTRO_DB_URL=jdbc:mysql://localhost:3306/db_bistro?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Jerusalem
BISTRO_DB_USER=your_mysql_user
BISTRO_DB_PASSWORD=your_mysql_password

# Email notifications
BISTRO_EMAIL=your_email@example.com
BISTRO_EMAIL_APP_PASSWORD=your_app_password

# Client -> Server
BISTRO_SERVER_HOST=localhost
BISTRO_SERVER_PORT=5555
