<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.CurrentCustomersController"
            prefWidth="800" prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom, #0e1320, #111b34);">

    <children>

        <!-- 🔹 TOP BAR -->
        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              AnchorPane.topAnchor="0"
              AnchorPane.rightAnchor="0"
              style="-fx-padding: 14 20;">

            <Button fx:id="backBtn"
                    text="←"
                    onAction="#back"
                    style="-fx-background-radius: 12;
                           -fx-background-color: #2b2f45;
                           -fx-text-fill: white;"/>

            <Button fx:id="exitBtn"
                    text="⏻"
                    onAction="#exit"
                    style="-fx-background-radius: 12;
                           -fx-background-color: #8a1b1b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>
        </HBox>

        <!-- 🔹 MAIN CONTENT -->
        <VBox spacing="15"
              alignment="CENTER"
              AnchorPane.topAnchor="60"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <padding>
                <Insets top="25" bottom="25" left="30" right="30"/>
            </padding>

            <Label text="Current Customers in Restaurant"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;" />

            <TableView fx:id="table"
                       prefWidth="700"
                       prefHeight="350">

                <columns>
                    <TableColumn fx:id="colName" text="Customer Name" prefWidth="180"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="180"/>
                    <TableColumn fx:id="colGuests" text="Guests" prefWidth="100"/>

                </columns>
            </TableView>

        </VBox>

    </children>
</AnchorPane>