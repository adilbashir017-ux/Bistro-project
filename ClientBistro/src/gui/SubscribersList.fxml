<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.SubscribersListController"
            prefWidth="800"
            prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom, #0e1320, #111b34);">

    <children>

        <HBox alignment="CENTER_RIGHT" spacing="12"
              AnchorPane.topAnchor="10"
              AnchorPane.rightAnchor="10"
              style="-fx-padding: 14 20;">
            <Button fx:id="backBtn"
                    text="←"
                    onAction="#back"
                    style="-fx-background-radius: 12;
                           -fx-background-color: #2b2f45;
                           -fx-text-fill: white;"/>

            <Button fx:id="exitBtn"
                    text="⏻"
                    onAction="#exit"
                    style="-fx-background-radius: 12;
                           -fx-background-color: #8a1b1b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>
        </HBox>

        <VBox spacing="15"
              alignment="CENTER"
              AnchorPane.topAnchor="50"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <padding>
                <Insets top="25" bottom="25" left="30" right="30"/>
            </padding>

            <!-- TITLE -->
            <Label text="Subscribers List"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;" />

            <!-- TABLE -->
            <TableView fx:id="table"
                       prefWidth="700"
                       prefHeight="350">

                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="180"/>
                </columns>

            </TableView>

        </VBox>

    </children>
</AnchorPane>