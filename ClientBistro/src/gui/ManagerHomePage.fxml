<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1200" prefHeight="650"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.ManagerHomePageController"
            stylesheets="@ManagerHomePage.css"
            style="-fx-background-color: linear-gradient(to bottom, #0e1320, #111b34);">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-padding: 14 20;">

            <Button text="Subscriber Dashboard" onAction="#onSubscriberDashboard"
                    style="-fx-background-radius: 20; -fx-background-color: #2b2f45; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16;"/>

            <Button text="Guest Dashboard" onAction="#onGuestDashboard"
                    style="-fx-background-radius: 20; -fx-background-color: #2b2f45; -fx-text-fill: white; -fx-padding: 6 16;"/>

            <Button fx:id="backBtn" text="←" onAction="#back"
                    style="-fx-background-radius: 12; -fx-background-color: #2b2f45; -fx-text-fill: white;"/>

            <Button fx:id="exitBtn" text="⏻" onAction="#exit"
                    style="-fx-background-radius: 12; -fx-background-color: #8a1b1b; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- MAIN -->
    <center>
    <ScrollPane fitToWidth="true"
                style="-fx-background: transparent; -fx-background-color: transparent;">

        <VBox alignment="TOP_CENTER" spacing="30"
              style="-fx-padding: 30;">

            <!-- HEADER -->
            <VBox alignment="CENTER" spacing="6"
                  prefWidth="900"
                  style="-fx-padding: 26 40;
                         -fx-background-radius: 30;
                         -fx-background-color: linear-gradient(to right, #5240d0, #e3a628);
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 25, 0.35, 0, 6);">

                <Label text="Manager Dashboard"
                       style="-fx-text-fill: white;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;"/>

                <Label text="Manage Restaurant Operations"
                       style="-fx-text-fill: #eeeeee;
                              -fx-font-size: 14;"/>
            </VBox>

            <!-- MANAGER ACTIONS CARD -->
            <VBox spacing="18" alignment="CENTER" prefWidth="850"
                  styleClass="manager-card">

                <Label text="Manager Actions"
                       style="-fx-text-fill: white;
                              -fx-font-size: 18;
                              -fx-font-weight: bold;"/>

                <Button text="Register Subscriber" onAction="#onRegisterSubscriber" styleClass="manager-button"/>
                <Button text="Manage Tables" onAction="#onManageTables" styleClass="manager-button"/>
                <Button text="Active Reservations" onAction="#onActiveReservations" styleClass="manager-button"/>
                <Button text="Opening Hours" onAction="#onOpeningHours" styleClass="manager-button"/>
                <Button text="View Reservations" onAction="#onViewReservations" styleClass="manager-button"/>
                <Button text="Waiting List" onAction="#onWaitingList" styleClass="manager-button"/>
                <Button text="Viewing Management Information" onAction="#onViewingManagementInformation" styleClass="manager-button"/>
                <Button text="Current Customers" onAction="#onCurrentCustomers" styleClass="manager-button"/>
                <Button text="Reports And Analysis" onAction="#onReportsAndAnalysis" styleClass="manager-button"/>
                <Button text="Subscribers List" onAction="#onSubscribers" styleClass="manager-button"/>

            </VBox>

        </VBox>
    </ScrollPane>
</center>


</BorderPane>
