<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefWidth="1200" prefHeight="650"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.RegisterSubscriberController"
            style="-fx-background-color: linear-gradient(to bottom, #0e1320, #111b34);">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="12"
              style="-fx-padding: 14 20;">
            <Button fx:id="backBtn"
                    text="←"
                    onAction="#back"
                    style="-fx-background-radius: 12;
                           -fx-background-color: #2b2f45;
                           -fx-text-fill: white;"/>

            <Button fx:id="exitBtn"
                    text="⏻"
                    onAction="#exit"
                    style="-fx-background-radius: 12;
                           -fx-background-color: #8a1b1b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ================= MAIN ================= -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="30"
              style="-fx-padding: 30;">

            <!-- ===== HEADER ===== -->
            <VBox alignment="CENTER" spacing="6"
                  prefWidth="900"
                  style="-fx-padding: 26 40;
                         -fx-background-radius: 30;
                         -fx-background-color: linear-gradient(to right, #5240d0, #e3a628);
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 25, 0.35, 0, 6);">

                <Label text="Register Subscriber"
                       style="-fx-text-fill: white;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;"/>

                <Label text="Create a new restaurant subscriber"
                       style="-fx-text-fill: #eeeeee;
                              -fx-font-size: 14;"/>
            </VBox>

            <!-- ===== FORM CARD ===== -->
            <HBox spacing="30" alignment="CENTER">

                <!-- FORM -->
                <VBox spacing="16" prefWidth="360"
                      style="-fx-padding: 22;
                             -fx-background-radius: 22;
                             -fx-background-color: #2b2f45;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 18, 0.3, 0, 5);">

                    <Label text="Subscriber Details"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 18;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="nameField"
                               promptText="Name"/>

                    <TextField fx:id="phoneField"
                               promptText="Phone"/>

                    <TextField fx:id="emailField"
                               promptText="Email"/>

                    <Button text="Create Subscriber"
                            onAction="#createSubscriber"
                            maxWidth="Infinity"
                            style="-fx-background-radius: 14;
                                   -fx-background-color: #5240d0;
                                   -fx-text-fill: white;
                                   -fx-font-size: 15;
                                   -fx-font-weight: bold;"/>

                    <Label fx:id="resultLabel"
                           wrapText="true"
                           style="-fx-text-fill: #ffb74d;"/>
                </VBox>

                <!-- QR PREVIEW -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-padding: 20;
                             -fx-background-radius: 22;
                             -fx-background-color: #2b2f45;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 18, 0.3, 0, 5);">

                    <Label text="Subscriber QR Code"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 18;
                                  -fx-font-weight: bold;"/>

                    <ImageView fx:id="qrImageView"
                               fitWidth="250"
                               fitHeight="250"
                               preserveRatio="true"
                               style="-fx-background-color: white;
                                      -fx-padding: 10;
                                      -fx-background-radius: 12;"/>
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>